<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.cvut.fit.pjv.thedrake.ui.controllers.GameController"
            prefHeight="700.0" prefWidth="900.0">

    <!-- Game Board Container -->
    <center>
        <BorderPane fx:id="gameContainer" styleClass="game-board-container">
            <!-- BoardView will be added here programmatically -->
        </BorderPane>
    </center>

    <!-- Right - Side Panel (optional - for game info, controls, etc.) -->
    <right>
        <VBox spacing="10.0" styleClass="game-info-panel">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>

            <Label text="The Drake" styleClass="game-title" />
            <Label text="Game Info Panel" styleClass="game-info" />

            <!-- TODO: Add game controls, player info, etc. -->
        </VBox>
    </right>
</BorderPane>
