<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cz.cvut.fit.pjv.thedrake.MainMenuController"
           styleClass="menu-background">

    <!-- Menu Content -->
    <BorderPane>
        <center>
            <VBox alignment="CENTER" spacing="20.0" styleClass="menu-container" BorderPane.alignment="CENTER" maxWidth="500.0">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <!-- Top Spacer -->
                <VBox styleClass="spacer-large" />

                <!-- Menu Buttons -->
                <Button fx:id="buttonSingleplayer"
                        text="Singleplayer"
                        styleClass="menu-button"
                        disable="true"
                        onAction="#onSinglePlayer" />

                <Button fx:id="buttonMultiplayer"
                        text="Multiplayer"
                        styleClass="menu-button"
                        onAction="#onMultiplayer" />

                <Button fx:id="buttonOnline"
                        text="Online"
                        styleClass="menu-button"
                        disable="true"
                        onAction="#onOnline" />

                <!-- Spacer -->
                <VBox styleClass="spacer-medium" />

                <Button fx:id="buttonExit"
                        text="Exit"
                        styleClass="menu-button"
                        onAction="#onExit" />
            </VBox>
        </center>
    </BorderPane>
</StackPane>
